{
  "name": "aurora-core",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "concurrently \"nodemon\" \"nodemon -x npx tsoa spec-and-routes\"",
    "build": "tsoa spec-and-routes && tsc -p tsconfig.app.json",
    "typecheck": "tsoa spec-and-routes && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "start": "node dist/src/index.js",
    "test": "tsoa spec-and-routes && vitest run",
    "test:watch": "vitest",
    "test:build": "tsoa spec-and-routes && vitest run",
    "tsoa": "tsoa spec-and-routes",
    "lint": "eslint ./src ./integration-test --max-warnings=0",
    "lint-fix": "eslint ./src ./integration-test --fix",
    "format": "prettier --ignore-path .gitignore --check ./src/",
    "format-fix": "prettier --ignore-path .gitignore --write ./src",
    "migrate": "typeorm-ts-node-commonjs migration:run -d src/database.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database.ts",
    "migrate:show": "typeorm-ts-node-commonjs migration:show -d src/database.ts",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate src/migrations/Migration -d src/database.ts",
    "seed": "ts-node src/seed/index.ts",
    "seed:gewis": "ts-node src/seed/index.ts --gewis",
    "seed:gewis-posters": "ts-node src/seed/index.ts --gewis-posters",
    "seed:hubble": "ts-node src/seed/index.ts --hubble",
    "prepare-husky": "husky",
    "validate": "ts-node -P tsconfig.app.json src/validate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fostertheweb/spotify-web-sdk": "1.3.0",
    "@gewis/sudosos-client": "1.34.0",
    "async-lock": "1.4.1",
    "axios": "1.17.0",
    "body-parser": "2.2.2",
    "commander": "14.0.2",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "file-type": "16.5.4",
    "globals": "17.1.0",
    "joi": "18.0.2",
    "jwt-decode": "4.0.0",
    "mime-types": "3.0.2",
    "multer": "2.0.2",
    "mysql2": "3.16.1",
    "node-cron": "4.2.1",
    "passport": "0.7.0",
    "passport-custom": "1.1.1",
    "pino": "10.3.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "qs": "6.14.1",
    "socket.io": "4.8.3",
    "sqlite3": "5.1.7",
    "swagger-ui-express": "5.0.1",
    "tsoa": "7.0.0-alpha.0",
    "typeorm": "0.3.28",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.1",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@tsoa/cli": "7.0.0-alpha.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/async-lock": "1.4.2",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.1",
    "@types/express-session": "1.18.2",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.7",
    "@types/node-cron": "3.0.11",
    "@types/passport": "1.0.17",
    "@types/passport-strategy": "0.2.38",
    "@types/qs": "6.15.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "nodemon": "3.1.11",
    "prettier": "3.8.1",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.6.0"
}
