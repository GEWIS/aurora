NODE_ENV=development
PORT=3000
TZ=Europe/Amsterdam
LOG_AUDIO_BEATS=true
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000, http://localhost:8080, http://localhost:8081
AUDIT_LOGS_MAX_AGE_DAYS=28
LIGHTS_TICK_INTERVAL=
STATIC_FILES_LOCATION=

TYPEORM_CONNECTION=sqlite
TYPEORM_HOST=
TYPEORM_PORT=
TYPEORM_DATABASE=local.sqlite
TYPEORM_USERNAME=
TYPEORM_PASSWORD=
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false
TYPEORM_SSL_ENABLED=false
TYPEORM_SSL_CACERTS=/etc/ssl/certs/ca-certificates.crt

SPOTIFY_ENABLE=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

SESSION_SECRET=secret
COOKIE_SECRET=secret

# Provider can be ENTRA_ID or KEYCLOAK. More information: https://github.com/GEWIS/aurora-core/wiki/Authentication-&-permissions
OIDC_PROVIDER=KEYCLOAK
OIDC_CONFIG=https://auth.gewis.nl/realms/GEWISWG/.well-known/openid-configuration/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

ROLE_ADMIN="PRIV - Narrowcasting Prod Admin"
ROLE_BOARD="PRIV - Narrowcasting Prod Board"
ROLE_KEY_HOLDER="PRIV - Narrowcasting Prod KeyHolder"
ROLE_BAC="PRIV - Narrowcasting Prod BAC"
ROLE_AVICO="PRIV - Narrowcasting Prod AViCo"

TRELLO_KEY=
TRELLO_BOARD_ID=
TRELLO_TOKEN=
TRELLO_SECRET=
TRELLO_BASE_POSTER_LIST_NAME=BasePosters

NS_KEY=
GEWIS_KEY=

# Info screen
# Weather location, rain location, train station and the events calendar URL are
# configured per-widget in the backoffice layout editor (no longer env vars).
# Minutes without a report after which a PC is treated as OFFLINE
INFOSCREEN_PC_STALE_MINUTES=5
# Uptime Kuma or Gatus URL backing the services widget; defaults to
# https://uptime.gewis.nl when blank. Used for the screen-wide broadcast; a
# services widget may override it with its own "statusPageUrl" setting.
STATUS_PAGE_URL=

# Keyholder sync from the GEWIS API (/keyholders + /boards), which needs the
# GEWIS_KEY above to carry the keyholders:read and boards:read permissions. Off
# when GEWIS_KEY is blank. The registry becomes the union of both endpoints.
# Photos, usernames and the candidate-board flag stay backoffice-managed.
# Minutes between runs (also runs once at startup); 0 runs only at startup
GEWIS_SYNC_INTERVAL_MINUTES=60

SUDOSOS_URL=
SUDOSOS_USER_ID=
SUDOSOS_KEY=
