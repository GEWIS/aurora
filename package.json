{
  "name": "aurora",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint-fix": "pnpm -r run lint-fix",
    "format": "prettier --check .",
    "format-fix": "prettier --write .",
    "sync": "pnpm --filter aurora-core run sync && pnpm --filter api-client run sync",
    "sync-check": "pnpm --filter aurora-core run sync-check && pnpm --filter api-client run sync-check",
    "prepare-husky": "husky",
    "prepare": "pnpm sync"
  },
  "keywords": [],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.6.0"
}
