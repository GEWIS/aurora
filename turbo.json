{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^sync"] },
    "lint": { "dependsOn": ["^sync"] },
    "lint-fix": { "dependsOn": ["^sync"] },
    "test": { "dependsOn": ["^sync"] },
    "sync": {},
    "sync-check": {}
  },
  "futureFlags": {
    "pruneIncludesGlobalFiles": true
  }
}
