{
  "name": "@gewis/aurora-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon\" \"nodemon -x npx tsoa spec-and-routes\"",
    "build": "tsoa routes && rolldown -c rolldown.config.ts",
    "typecheck": "tsoa routes && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "start": "node dist/src/index.js",
    "test": "tsoa routes && vitest run",
    "test:watch": "vitest",
    "test:build": "tsoa routes && vitest run",
    "lint": "eslint ./src ./integration-test --max-warnings=0",
    "lint-fix": "eslint ./src ./integration-test --fix",
    "sync": "tsx scripts/sync.ts",
    "sync-check": "tsx scripts/sync.ts --check",
    "diagram:deps": "tsx scripts/gen-module-deps.ts --modules-only",
    "docker-build": "docker build -f Dockerfile -t aurora-core ../..",
    "migrate": "rolldown -c rolldown.config.cli.ts && typeorm migration:run -d build/cli/typeorm-cli.js",
    "migrate:revert": "rolldown -c rolldown.config.cli.ts && typeorm migration:revert -d build/cli/typeorm-cli.js",
    "migrate:show": "rolldown -c rolldown.config.cli.ts && typeorm migration:show -d build/cli/typeorm-cli.js",
    "migrate:generate": "rolldown -c rolldown.config.cli.ts && typeorm migration:generate src/migrations/Migration -d build/cli/typeorm-cli.js",
    "seed": "rolldown -c rolldown.config.cli.ts && node build/cli/seed/index.js",
    "seed:gewis": "rolldown -c rolldown.config.cli.ts && node build/cli/seed/index.js --gewis",
    "seed:gewis-posters": "rolldown -c rolldown.config.cli.ts && node build/cli/seed/index.js --gewis-posters",
    "seed:hubble": "rolldown -c rolldown.config.cli.ts && node build/cli/seed/index.js --hubble",
    "validate": "rolldown -c rolldown.config.cli.ts && node build/cli/validate.js"
  },
  "dependencies": {
    "@fostertheweb/spotify-web-sdk": "1.3.0",
    "@gewis/aurora-api-client": "workspace:*",
    "@gewis/sudosos-client": "1.34.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "async-lock": "1.4.1",
    "axios": "1.17.0",
    "body-parser": "2.2.2",
    "commander": "14.0.3",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "file-type": "16.5.4",
    "globals": "17.12.0",
    "joi": "18.2.9",
    "inversify": "8.2.3",
    "jwt-decode": "4.0.0",
    "mime-types": "3.0.2",
    "multer": "2.4.0",
    "mysql2": "3.16.1",
    "node-cron": "4.2.1",
    "passport": "0.7.0",
    "passport-custom": "1.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "qs": "6.14.1",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3",
    "sqlite3": "5.1.7",
    "swagger-ui-express": "5.0.1",
    "tsoa": "7.0.0-alpha.0",
    "typeorm": "0.3.31",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@tsoa/cli": "7.0.0-alpha.0",
    "@types/async-lock": "1.4.2",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/express-session": "1.19.0",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/node-cron": "3.0.11",
    "@types/passport": "1.0.17",
    "@types/passport-strategy": "0.2.38",
    "@types/qs": "6.15.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "concurrently": "9.2.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "nodemon": "3.1.14",
    "rolldown": "1.2.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
