{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "sync": {
      "dependsOn": ["@gewis/aurora-core#sync"],
      "cache": false
    },
    "build": {
      "dependsOn": ["sync"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["sync"]
    }
  }
}
