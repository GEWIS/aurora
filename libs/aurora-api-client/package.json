{
  "name": "@gewis/aurora-api-client",
  "version": "1.0.0",
  "description": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b --noEmit tsconfig.lib.json",
    "prepublishOnly": "tsdown",
    "sync": "openapi-ts"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./openapi.json": "./openapi.json",
    ".": {
      "development": "./src/api-client/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "development": "./src/api-client/client.gen.ts",
      "types": "./dist/client.gen.d.mts",
      "default": "./dist/client.gen.mjs"
    },
    "./schemas": {
      "development": "./src/api-client/schemas.gen.ts",
      "types": "./dist/schemas.gen.d.mts",
      "default": "./dist/schemas.gen.mjs"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
