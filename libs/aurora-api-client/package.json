{
  "name": "@gewis/aurora-api-client",
  "version": "1.0.0",
  "description": "",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -b --noEmit tsconfig.lib.json",
    "prepublishOnly": "tsc -b tsconfig.lib.json",
    "sync": "openapi-ts"
  },
  "main": "src/api-client/index.ts",
  "types": "src/api-client/index.ts",
  "exports": {
    "./openapi.json": "./openapi.json",
    ".": {
      "development": "./src/api-client/index.ts",
      "types": "./dist/api-client/index.d.ts",
      "default": "./dist/api-client/index.js"
    },
    "./client": {
      "development": "./src/api-client/client.gen.ts",
      "types": "./dist/api-client/client.gen.d.ts",
      "default": "./dist/api-client/client.gen.js"
    },
    "./schemas": {
      "development": "./src/api-client/schemas.gen.ts",
      "types": "./dist/api-client/schemas.gen.d.ts",
      "default": "./dist/api-client/schemas.gen.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "dependencies": {
    "@hey-api/client-fetch": "0.10.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.98.2",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
