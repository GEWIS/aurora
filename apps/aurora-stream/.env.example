STREAM_TOKEN=secret

CONTROL_PORT=9000
AUTH_PORT=9001

WEBRTC_PUBLIC=http://localhost:8889
RTSP_PUBLIC=rtsp://localhost:8554

RTSP_INTERNAL=rtsp://localhost:8554

# The single address MediaMTX advertises as an ICE candidate. Firefox gathers no loopback
# candidate, so if a publish stalls with DTLS never completing, set this to your LAN IP.
# MTX_WEBRTCADDITIONALHOSTS=192.168.68.106

LOG_LEVEL=info
