{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*-controller.ts"],
  "spec": {
    "name": "Aurora Core API - CHANGE",
    "version": "1.0.0",
    "description": "API contract for the Aurora Core service.",
    "license": {
      "name": "AGPL-3.0",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    },
    "contact": {
      "name": "GEWIS",
      "url": "https://www.gewis.nl",
      "email": "abc@gewis.nl"
    },
    "basePath": "/api",
    "securityDefinitions": {
      "local": {
        "type": "apiKey",
        "name": "connect.sid",
        "in": "cookie"
      },
      "integration": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    },
    "outputDirectory": "../../libs/aurora-api-client",
    "specFileBaseName": "openapi",
    "host": "",
    "specVersion": 3,
    "schemes": ["http", "https"],
    "specMerging": "recursive",
    "spec": {
      "components": {
        "schemas": {
          "OidcParameters": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string"
              },
              "session_state": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "ApiKeyParameters": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "paths": {
        "/auth/mock": {
          "post": {
            "operationId": "AuthMock",
            "responses": {
              "200": {
                "description": "Success",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/AuthUser"
                    }
                  }
                }
              }
            },
            "security": [],
            "parameters": [],
            "tags": ["Authentication"],
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AuthUser"
                  }
                }
              }
            }
          }
        },
        "/auth/oidc": {
          "post": {
            "operationId": "AuthOIDC",
            "responses": {
              "200": {
                "description": "Success",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/AuthUser"
                    }
                  }
                }
              }
            },
            "security": [],
            "parameters": [],
            "tags": ["Authentication"],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/OidcParameters"
                  }
                }
              }
            }
          }
        },
        "/auth/key": {
          "post": {
            "operationId": "AuthKey",
            "responses": {
              "200": {
                "description": "Success",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/AuthUser"
                    }
                  }
                }
              }
            },
            "security": [],
            "parameters": [],
            "tags": ["Authentication"],
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiKeyParameters"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "routes": {
    "authenticationModule": "src/modules/auth/authentication.ts",
    "basePath": "/api",
    "routesDir": "build",
    "middleware": "express"
  }
}
